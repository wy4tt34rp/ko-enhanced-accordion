{
  "name": "ko/enhanced-accordion",
  "d4Shortcode": "",
  "title": "KO: Enhanced Accordion",
  "titles": "KO: Enhanced Accordions",
  "moduleClassName": "ko_enhanced_accordion",
  "moduleOrderClassName": "ko_enhanced_accordion",
  "category": "module",
  "childModuleName": "ko/enhanced-accordion-item",
  "childModuleTitle": "Accordion Item",
  "childModuleTitleAttribute": "itemTitle",
  "childrenName": ["ko/enhanced-accordion-item"],
  "attributes": {
    "module": {
      "type": "object", "selector": "{{selector}}",
      "default": { "meta": { "adminLabel": { "desktop": { "value": "KO: Enhanced Accordion" } } } },
      "settings": {
        "meta": { "adminLabel": {} },
        "advanced": {
          "link": {},
          "htmlAttributes": {},
          "text": { "groupType": "group-item", "item": { "groupSlug": "designText", "priority": 10, "render": true, "component": { "type": "group", "name": "divi/text", "props": { "grouped": false, "groupTab": "body", "groupTabLabel": "Body", "icon": "divi/text-align-left", "fieldLabel": "Text" } } } }
        },
        "decoration": { "attributes": {}, "background": {}, "layout": {}, "sizing": {}, "spacing": {}, "border": {}, "boxShadow": {}, "filters": {}, "transform": {}, "animation": {}, "overflow": {}, "disabledOn": {}, "transition": {}, "position": {}, "zIndex": {}, "scroll": {}, "sticky": {} }
      }
    },
    "itemLayout": {
      "type": "object", "selector": "{{selector}}",
      "default": { "advanced": {
        "itemGap": {
          "desktop": { "value": "10px" },
          "tablet": { "value": "10px" },
          "phone": { "value": "10px" }
        }
      } },
      "settings": { "advanced": {
        "itemGap": { "groupType": "group-item", "item": { "groupSlug": "designItemLayout", "attrName": "itemLayout.advanced.itemGap", "label": "Item Gap", "description": "Set the vertical space between accordion items.", "priority": 10, "render": true, "features": { "responsive": true, "sticky": false, "dynamicContent": false }, "component": { "name": "divi/range", "type": "field", "props": { "min": 0, "max": 200, "step": 1, "allowedUnits": ["px", "em", "rem"], "defaultUnit": "px" } } } }
      } }
    },
    "iconStyle": {
      "type": "object", "selector": "{{selector}}",
      "default": { "advanced": {
        "openIcon": { "desktop": { "value": { "unicode": "&#xf077;", "type": "fa", "weight": "900" } } },
        "iconColor": { "desktop": { "value": "#f58220" } },
        "iconSize": { "desktop": { "value": "16px" } },
        "iconPlacement": { "desktop": { "value": "right" } }
      } },
      "settings": { "advanced": {
        "openIcon": { "groupType": "group-item", "item": { "groupSlug": "designIcon", "attrName": "iconStyle.advanced.openIcon", "label": "Close Icon", "description": "Choose the icon displayed while an item is open.", "priority": 10, "render": true, "features": { "responsive": false, "sticky": false }, "component": { "name": "divi/icon-picker", "type": "field" } } },
        "iconColor": { "groupType": "group-item", "item": { "groupSlug": "designIcon", "attrName": "iconStyle.advanced.iconColor", "label": "Close Icon Color", "priority": 20, "render": true, "component": { "name": "divi/color-picker", "type": "field" } } },
        "iconSize": { "groupType": "group-item", "item": { "groupSlug": "designIcon", "attrName": "iconStyle.advanced.iconSize", "label": "Close Icon Size", "priority": 30, "render": true, "component": { "name": "divi/range", "type": "field", "props": { "min": 1, "max": 100, "step": 1, "allowedUnits": ["px", "em", "rem"], "defaultUnit": "px" } } } },
        "iconPlacement": { "groupType": "group-item", "item": { "groupSlug": "designIcon", "attrName": "iconStyle.advanced.iconPlacement", "label": "Icon Placement", "priority": 40, "render": true, "features": { "responsive": false, "sticky": false }, "component": { "name": "divi/select", "type": "field", "props": { "options": { "left": { "label": "Left" }, "right": { "label": "Right" } }, "defaultValue": "right" } } } }
      } }
    },
    "toggleStyle": {
      "type": "object", "selector": "{{selector}}",
      "default": { "advanced": {
        "openBackground": { "desktop": { "value": "#f1f3f5" } },
        "closedBackground": { "desktop": { "value": "#f1f3f5" } },
        "dividerColor": { "desktop": { "value": "rgba(0,0,0,0)" } },
        "dividerWidth": { "desktop": { "value": "1px" } }
      } },
      "settings": { "advanced": {
        "openBackground": { "groupType": "group-item", "item": { "groupSlug": "designToggle", "attrName": "toggleStyle.advanced.openBackground", "label": "Open Toggle Background", "priority": 10, "render": true, "component": { "name": "divi/color-picker", "type": "field" } } },
        "closedBackground": { "groupType": "group-item", "item": { "groupSlug": "designToggle", "attrName": "toggleStyle.advanced.closedBackground", "label": "Closed Toggle Background", "priority": 20, "render": true, "component": { "name": "divi/color-picker", "type": "field" } } },
        "dividerColor": { "groupType": "group-item", "item": { "groupSlug": "designToggle", "attrName": "toggleStyle.advanced.dividerColor", "label": "Divider Color", "priority": 30, "render": true, "component": { "name": "divi/color-picker", "type": "field" } } },
        "dividerWidth": { "groupType": "group-item", "item": { "groupSlug": "designToggle", "attrName": "toggleStyle.advanced.dividerWidth", "label": "Divider Width", "priority": 40, "render": true, "component": { "name": "divi/range", "type": "field", "props": { "min": 0, "max": 20, "step": 1, "allowedUnits": ["px"], "defaultUnit": "px" } } } }
      } }
    },
    "titleText": { "type": "object", "label": "Title Text", "selector": "{{selector}} .ko_enhanced_accordion_item__title > button", "elementType": "title", "default": { "decoration": { "font": { "font": { "desktop": { "value": { "size": "18px", "lineHeight": "1.4em" } } } } } }, "settings": { "decoration": { "font": {}, "textShadow": {} } } },
    "closedTitleText": { "type": "object", "label": "Closed Title Text", "selector": "{{selector}} .ko_enhanced_accordion_item:not(.is-open) .ko_enhanced_accordion_item__title > button", "elementType": "title", "settings": { "decoration": { "font": {}, "textShadow": {} } } },
    "bodyText": { "type": "object", "label": "Body Text", "selector": "{{selector}} .ko_enhanced_accordion_item__content-inner", "elementType": "content", "settings": { "decoration": { "bodyFont": {} } } },
    "behavior": {
      "type": "object", "selector": "{{selector}}",
      "default": { "advanced": {
        "initialState": { "desktop": { "value": "closed" } },
        "duration": { "desktop": { "value": "180ms" } },
        "closeCurrent": { "desktop": { "value": "on" } },
        "closedIcon": { "desktop": { "value": { "unicode": "&#xf078;", "type": "fa", "weight": "900" } } },
        "closedIconColor": { "desktop": { "value": "#f58220" } },
        "closedIconSize": { "desktop": { "value": "16px" } }
      } },
      "settings": { "advanced": {
        "initialState": { "groupType": "group-item", "item": { "groupSlug": "contentBehavior", "attrName": "behavior.advanced.initialState", "label": "OnLoad Behavior", "description": "Choose whether all items start closed or the first item starts open.", "priority": 10, "render": true, "features": { "responsive": false, "sticky": false, "dynamicContent": false }, "component": { "name": "divi/select", "type": "field", "props": { "options": { "closed": { "label": "All Items Closed" }, "open": { "label": "First Item Open" } }, "defaultValue": "closed" } } } },
        "duration": { "groupType": "group-item", "item": { "groupSlug": "contentBehavior", "attrName": "behavior.advanced.duration", "label": "Transition Speed", "description": "Set the accordion open and close animation duration.", "priority": 20, "render": true, "features": { "responsive": false, "sticky": false }, "component": { "name": "divi/range", "type": "field", "props": { "min": 0, "max": 2000, "step": 10, "allowedUnits": ["ms"], "defaultUnit": "ms" } } } },
        "closeCurrent": { "groupType": "group-item", "item": { "groupSlug": "contentBehavior", "attrName": "behavior.advanced.closeCurrent", "label": "Close Current Item", "description": "Close the currently open item when another item is selected. Turn this off to allow multiple items to remain open.", "priority": 30, "render": true, "features": { "responsive": false, "sticky": false, "dynamicContent": false }, "component": { "name": "divi/toggle", "type": "field", "props": { "options": { "off": "off", "on": "on" }, "defaultValue": "on" } } } },
        "closedIcon": { "groupType": "group-item", "item": { "groupSlug": "designClosedIcon", "attrName": "behavior.advanced.closedIcon", "label": "Open Icon", "description": "Choose the icon displayed while an item is closed.", "priority": 10, "render": true, "features": { "responsive": false, "sticky": false }, "component": { "name": "divi/icon-picker", "type": "field" } } },
        "closedIconColor": { "groupType": "group-item", "item": { "groupSlug": "designClosedIcon", "attrName": "behavior.advanced.closedIconColor", "label": "Open Icon Color", "priority": 20, "render": true, "component": { "name": "divi/color-picker", "type": "field" } } },
        "closedIconSize": { "groupType": "group-item", "item": { "groupSlug": "designClosedIcon", "attrName": "behavior.advanced.closedIconSize", "label": "Open Icon Size", "priority": 30, "render": true, "component": { "name": "divi/range", "type": "field", "props": { "min": 1, "max": 100, "step": 1, "allowedUnits": ["px", "em", "rem"], "defaultUnit": "px" } } } }
      } }
    }
  },
  "customCssFields": {
    "accordionItem": { "label": "Accordion Item", "subName": "accordionItem", "selectorSuffix": " .ko_enhanced_accordion_item" },
    "openAccordionItem": { "label": "Open Accordion Item", "subName": "openAccordionItem", "selectorSuffix": " .ko_enhanced_accordion_item.is-open" },
    "accordionTitle": { "label": "Accordion Title", "subName": "accordionTitle", "selectorSuffix": " .ko_enhanced_accordion_item__title > button" },
    "accordionIcon": { "label": "Accordion Icon", "subName": "accordionIcon", "selectorSuffix": " .ko_enhanced_accordion_item__icon" },
    "accordionContent": { "label": "Accordion Content", "subName": "accordionContent", "selectorSuffix": " .ko_enhanced_accordion_item__content-inner" }
  },
  "settings": { "content": "auto", "design": "auto", "advanced": "auto", "groups": {
    "contentBehavior": { "panel": "content", "priority": 10, "groupName": "contentBehavior", "multiElements": true, "component": { "name": "divi/composite", "props": { "groupLabel": "Behavior" } } },
    "designItemLayout": { "panel": "design", "priority": 10, "groupName": "designItemLayout", "multiElements": true, "component": { "name": "divi/composite", "props": { "groupLabel": "Item Layout" } } },
    "designIcon": { "panel": "design", "priority": 20, "groupName": "designIcon", "multiElements": true, "component": { "name": "divi/composite", "props": { "groupLabel": "Close Icon" } } },
    "designClosedIcon": { "panel": "design", "priority": 30, "groupName": "designClosedIcon", "multiElements": true, "component": { "name": "divi/composite", "props": { "groupLabel": "Open Icon" } } },
    "designToggle": { "panel": "design", "priority": 40, "groupName": "designToggle", "multiElements": true, "component": { "name": "divi/composite", "props": { "groupLabel": "Toggle" } } },
    "designText": { "panel": "design", "priority": 50, "groupName": "designText", "multiElements": true, "component": { "name": "divi/composite", "props": { "groupLabel": "Text" } } }
  } }
}
